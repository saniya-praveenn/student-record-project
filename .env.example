# Server port (Render injects PORT automatically; defaults to 3000 locally)
PORT=3000

# Optional directory path for students.json (set to /var/data when using a Render Persistent Disk)
# DATA_DIR=./data

# GEMINI_API_KEY: Not required for this project (kept for environment compatibility)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted application URL (injected automatically in cloud preview environments)
APP_URL="MY_APP_URL"
